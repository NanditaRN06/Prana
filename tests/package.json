{
  "name": "prana-tests",
  "version": "1.0.0",
  "description": "Test environment for Prana CMS",
  "type": "module",
  "scripts": {
    "test:be": "cross-env MONGOMS_DOWNLOAD_DIR=./node_modules/.cache/mongodb-binaries NODE_OPTIONS=--experimental-vm-modules jest",
    "test:be:unit": "npm run test:be -- --testPathPattern=tests/unit/backend",
    "test:be:integration": "npm run test:be -- --testPathPattern=tests/integration/backend",
    "test:be:e2e": "npm run test:be -- --testPathPattern=tests/e2e/backend",
    "test:be:system": "npm run test:be -- --testPathPattern=tests/system/backend",
    "test:be:coverage": "npm run test:be -- --coverage",

    "test:fe": "vitest run",
    "test:fe:unit": "vitest run unit/frontend",
    "test:fe:integration": "vitest run integration/frontend",
    "test:fe:e2e": "vitest run e2e/frontend",
    "test:fe:system": "vitest run system/frontend",
    "test:fe:coverage": "vitest run --coverage",

    "test": "npm run test:be && npm run test:fe",
    "test:all:coverage": "npm run test:be:coverage && npm run test:fe:coverage",

    "cleanup": "rimraf coverage node_modules/.cache/mongodb-binaries ../.vite",

    "posttest:be": "npm run cleanup",
    "posttest:be:unit": "npm run cleanup",
    "posttest:be:integration": "npm run cleanup",
    "posttest:be:e2e": "npm run cleanup",
    "posttest:be:system": "npm run cleanup",
    "posttest:be:coverage": "npm run cleanup",
    
    "posttest:fe": "npm run cleanup",
    "posttest:fe:unit": "npm run cleanup",
    "posttest:fe:integration": "npm run cleanup",
    "posttest:fe:e2e": "npm run cleanup",
    "posttest:fe:system": "npm run cleanup",
    "posttest:fe:coverage": "npm run cleanup",
    
    "posttest": "npm run cleanup",
    "posttest:all:coverage": "npm run cleanup"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "axios": "^1.16.0",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "mongodb-memory-server": "^9.1.6",
    "mongoose": "^8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "vitest": "^1.3.1"
  }
}