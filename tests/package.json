{
  "name": "prana-tests",
  "version": "1.0.0",
  "description": "Test environment for Prana CMS",
  "type": "module",
  "scripts": {
    "test:be": "cross-env MONGOMS_DOWNLOAD_DIR=./node_modules/.cache/mongodb-binaries NODE_OPTIONS=--experimental-vm-modules jest",
    "test:fe": "vitest run",
    "test:all": "npm run test:be && npm run test:fe",
    "cleanup:binaries": "rimraf node_modules/.cache/mongodb-binaries",
    "posttest:be": "npm run cleanup:binaries",
    "posttest:all": "npm run cleanup:binaries"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jsdom": "^24.0.0",
    "mongodb-memory-server": "^9.1.6",
    "mongoose": "^8.0.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "vitest": "^1.3.1"
  }
}